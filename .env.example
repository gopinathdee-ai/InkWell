# Copy to .env.local and fill in.

# Neon Postgres connection string (Neon dashboard > Connect)
DATABASE_URL=postgresql://neondb_owner:****@****-pooler.c-5.us-west-2.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Single admin account
ADMIN_EMAIL=
# Generate with: npm run hash-password -- "your password"
# In .env.local escape every $ as \$ (the script prints the escaped form)
ADMIN_PASSWORD_HASH=
VERCEL_ADMIN_PASSWORD_HASH=

# At least 32 random characters. Generate: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
SESSION_SECRET=

# Vercel Blob token for image uploads. Leave empty locally to save to public/uploads.
BLOB_READ_WRITE_TOKEN=

# Base URL for RSS, sitemap and share cards. Set when the domain is known.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
