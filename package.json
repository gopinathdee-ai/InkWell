{
  "name": "blog-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/db/migrate.ts",
    "db:seed:mandatory": "tsx --env-file=.env.local scripts/db/seed-mandatory.ts",
    "db:seed:optional": "tsx --env-file=.env.local scripts/db/seed-optional.ts",
    "db:reset": "tsx --env-file=.env.local scripts/db/reset.ts",
    "db:reset:recreate": "npm run db:reset && npm run db:migrate && npm run db:seed:mandatory",
    "db:studio": "drizzle-kit studio",
    "hash-password": "tsx scripts/hash-password.ts"
  },
  "dependencies": {
    "@fontsource-variable/dancing-script": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tiptap/extension-image": "^3.32.2",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
